# Normaliza los finales de linea: en el repositorio siempre LF,
# en Windows se ven como CRLF. Evita que un archivo aparezca como
# "modificado por completo" cuando en realidad no cambio nada.
* text=auto

# Archivos que no son texto: no tocar nunca
*.xls  binary
*.xlsx binary
*.png  binary
*.jpg  binary
*.pdf  binary

# Scripts de Windows: siempre CRLF, cmd.exe lo necesita
*.bat  text eol=crlf
*.ps1  text eol=crlf
