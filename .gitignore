# Credenciales - NUNCA subir
.github_token

# Registros de las corridas: no van al repo. Son locales, cambian en cada
# corrida y ensuciarian el historial con un commit por dia.
log_actualizacion.txt
log_actualizacion.txt.old
log_actualizar.txt
log_icc_indec.txt
log_ieric_cordoba.txt

# Planillas que baja probar_ieric_cordoba.py para inspeccionarlas. Son de
# consulta, no fuente: el repo es publico y todo lo que queda suelto en la
# carpeta se publica solo en la corrida siguiente.
_diagnostico_ieric/

# Archivo obsoleto: quedo de cuando el ICC INDEC se cargaba a mano, antes de
# encontrar el Excel del INDEC. Se puede borrar de la carpeta.
icc_indec_manual.json

# Marca de control de actualizar_auto.bat: guarda la fecha de la ultima
# corrida en que se actualizaron las fuentes mensuales. Es local de cada PC.
.ultima_corrida_mensual

# Archivos derivados (los regenera build_publicar.py)
tablero_elyon_portable.html
*.bak.html

# Python
__pycache__/
*.pyc

# Sistema
.DS_Store
Thumbs.db
desktop.ini

# Temporales de la escritura atomica de los caches (se escribe x.js.tmp y se
# renombra sobre x.js). En esta carpeta, con Dropbox de por medio, a veces
# sobrevive el .tmp: es una copia, no una fuente, y no va al repo.
*.js.tmp

# Los informes de CEDUC. El PDF y el Excel son el original que manda la
# camara: no tienen por que estar en un repositorio publico. Se quedan en la
# PC. Lo que si se publica es ceduc_cache.js, que es la serie que usa el
# tablero.
ceduc/*.pdf
ceduc/*.xlsx

# PDFs que baja probar_cifras.py para inspeccionarlos. Son de consulta.
_diagnostico_cifras/

# Informes del INDEC que uso para leer los cuadros 3 y 4 (empleo y permisos).
# Lo que se publica es isac_manual.json / isac_cache.js, no el PDF original.
isac/*.pdf
isac/*.xls
isac/*.xlsx
